# MongoDB Configuration
MONGODB_HOST=localhost
MONGODB_PORT=27017
MONGODB_DATABASE=mekongai_social
MONGODB_USERNAME=
MONGODB_PASSWORD=
# Preferred connection string (overrides host/port when set)
MONGODB_CONNECTION=mongodb://localhost:27017/mekongai_social

# Server Configuration
SERVER_ADDRESS=http://localhost:1975
FRONTEND_URL=http://localhost:3002

# Qdrant Configuration (vector search for RAG)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_SERVER=http://localhost:6333
QDRANT_API_KEY=

# AWS S3 (document & image storage)
AWS_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# OpenAI (required for AI chatbot)
OPENAI_API_KEY=your_openai_api_key_here

# Facebook Messenger Integration
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_VERIFY_TOKEN=
FACEBOOK_REDIRECT_URI=

# JWT & Authentication
SECRET_KEY=
JWT_SECRET_KEY=
JWT_REFRESH_KEY=
JWT_REFRESH_SECRET=
JWT=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=365

# SuperAdmin Bootstrap
SUPERADMIN_EMAIL=admin@mekongai.com
SUPERADMIN_PASSWORD=change_me

# White Label (optional)
IS_WHITE_LABEL_SYSTEM=false
WHITE_LABEL_API_KEY=
WHITE_LABEL_PARTNER_ID=
WHITE_LABEL_COMPANY_NAME=MekongAI
WHITE_LABEL_DOMAIN=mekongai.com
MEKONGAI_SUPERADMIN_API_URL=https://api.mekongai.com/super-admin

# PayOS Payment Gateway (optional)
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Optional: Self-hosted LLM
VLLM_URL=
VLLM_TOKEN=

# Optional: Mem0 long-term memory
ENABLE_MEM0=false

# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:1975/api/v1
